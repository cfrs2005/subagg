# Required secrets.
# ADMIN_TOKEN also derives the key that encrypts stored IX relay credentials, so
# rotating it makes already-stored credentials permanently undecryptable. That is
# handled gracefully (the provider is flagged for re-entry and its profiles fall
# back to direct connections) but you will have to type them in again.
ADMIN_TOKEN=
IP_HASH_SALT=

HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DB_PATH=./data/subagg.db
TRUST_PROXY=false

# The token limiter blocks short bursts, not slow sharing.
SUB_RATE_LIMIT=60
SUB_TOKEN_RATE_LIMIT=20
# Source alerts only. 0 disables the alert.
SHARE_SOURCE_ALERT=3
# 0 disables pruning; otherwise the minimum is 30 days.
ACCESS_LOG_RETENTION_DAYS=90

SCHEDULER_INTERVAL_MIN=5

# IX relay orchestration. Sync only refreshes local mappings; rendering never
# calls the relay platform, so 0 (disabled) still serves subscriptions.
IX_SYNC_INTERVAL_HOURS=6
IX_TIMEOUT_MS=15000
# Consecutive syncs without seeing a node before its mapping is flagged orphan.
IX_ORPHAN_THRESHOLD=5

LOG_LEVEL=info
