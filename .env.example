# Required secrets
ADMIN_TOKEN=
IP_HASH_SALT=

HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DB_PATH=./data/subagg.db
TRUST_PROXY=false

# The token limiter blocks short bursts, not slow sharing.
SUB_RATE_LIMIT=60
SUB_TOKEN_RATE_LIMIT=20
# Source alerts only. 0 disables the alert.
SHARE_SOURCE_ALERT=3
# 0 disables pruning; otherwise the minimum is 30 days.
ACCESS_LOG_RETENTION_DAYS=90

SCHEDULER_INTERVAL_MIN=5
LOG_LEVEL=info
