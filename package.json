{
  "name": "subagg",
  "version": "0.1.0",
  "description": "Self-hosted proxy subscription aggregator — merge upstream subscriptions, filter nodes, and serve one link that adapts to Clash / Shadowrocket / V2Ray automatically.",
  "keywords": [
    "subscription",
    "aggregator",
    "clash",
    "mihomo",
    "shadowrocket",
    "v2ray",
    "proxy",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "openid-client": "^6.8.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ]
}
